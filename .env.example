APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=lighting_monitor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

REDIS_URL=redis://redis:6379/0

S3_ENDPOINT=http://minio:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET=documents
S3_REGION=us-east-1

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TIMEZONE=Europe/Rome

CORS_ORIGINS=http://localhost:3000

# Auth (REQUIRED — generate a random ≥32 char secret in production!)
JWT_SECRET=dev-only-secret-change-in-production-with-32-plus-chars!!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=720

# Bootstrap admin (only consumed by infra/scripts/seed_admin.py, run once)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=changeme-min-12-chars

NEXT_PUBLIC_API_URL=http://localhost:8000

# Anthropic API key for the smart-LLM collector (Claude Haiku 4.5).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
SMART_COLLECTOR_MAX_HTML_CHARS=80000

# Regional email digests (Level 2). Leave SMTP_HOST empty to keep email off.
# Outlook/Microsoft 365: SMTP_HOST=smtp-mail.outlook.com, SMTP_PORT=587,
# SMTP_USER=<mailbox>, SMTP_PASSWORD=<app password>, SMTP_FROM=<mailbox>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
WEB_BASE_URL=http://localhost:3000
# Default recipient for every region at seed time (comma-separated; editable in the UI).
REGION_DEFAULT_RECIPIENTS=andrea.avenoso@outlook.com

# Services to look for (keys from packages/shared_models/shared_models/services.py,
# comma-separated). Empty = all: illuminazione_pubblica, illuminazione_artistica,
# piste_ciclabili_pedonali, semafori, videosorveglianza, relamping_edifici,
# fotovoltaico_cer, ricarica_ev, connettivita_5g, digital_advertising, smart_city.
ENABLED_SERVICES=

# Cost counter: your Anthropic monthly spending limit in USD (optional, shows how much of it
# this app used) and price overrides (USD per million tokens; 0 = built-in table).
# ANTHROPIC_BUDGET_USD=50
# Estrazione degli avvisi: auto (Claude, e senza costi con le regole se Claude non e' disponibile),
# claude (mai le regole) o rules (mai Claude: nessun costo).
EXTRACTION_MODE=auto
# Ricerca referenti: agent (Claude cerca sul web e apre le pagine, circa $0,2-0,5 a comune),
# pagine (legge solo le pagine del comune) o auto (agent se Claude e' disponibile).
REFERENTI_MODE=auto
REFERENTI_MODEL=claude-sonnet-5-5
ANTHROPIC_PRICE_INPUT_PER_MTOK=0
ANTHROPIC_PRICE_OUTPUT_PER_MTOK=0